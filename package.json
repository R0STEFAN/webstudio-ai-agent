{
  "name": "tattoo-v3-test",
  "version": "1.0.0",
  "description": "Local Webstudio MCP bridge & AI agent toolkit for designing, mutating, and cloud-syncing Webstudio projects offline with 0 API limits.",
  "type": "module",
  "main": "scripts/setup-local-mcp.mjs",
  "scripts": {
    "postinstall": "node scripts/setup-local-mcp.mjs",
    "setup": "node scripts/setup-local-mcp.mjs",
    "gui": "node scripts/gui-server.mjs",
    "update-webstudio": "npm i webstudio@latest @webstudio-is/image@latest @webstudio-is/react-sdk@latest @webstudio-is/sdk@latest @webstudio-is/sdk-components-animation@latest @webstudio-is/sdk-components-react@latest @webstudio-is/sdk-components-react-radix@latest @webstudio-is/sdk-components-react-remix@latest @webstudio-is/sdk-components-react-router@latest @webstudio-is/wsauth@latest",
    "cli": "node scripts/ai-designer/cli.mjs",
    "upload-assets": "node scripts/upload-assets.mjs",
    "index": "node scripts/google-index.mjs",
    "gsc": "node scripts/gsc-analytics.mjs",
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "typecheck": "tsc --noEmit",
    "deploy": "npm run build && node scripts/deploy-cloudflare.mjs",
    "start": "wrangler pages dev ./build/client",
    "typegen": "wrangler types",
    "preview": "npm run build && wrangler pages dev ./build/client",
    "build-cf-types": "wrangler types"
  },
  "keywords": [
    "webstudio",
    "mcp",
    "model-context-protocol",
    "ai-agent",
    "antigravity",
    "cursor",
    "claude-code",
    "windsurf",
    "visual-builder"
  ],
  "author": "R0STEFAN",
  "license": "MIT",
  "dependencies": {
    "@remix-run/cloudflare": "2.16.5",
    "@remix-run/cloudflare-pages": "2.16.5",
    "@remix-run/node": "2.16.5",
    "@remix-run/react": "2.16.5",
    "@remix-run/server-runtime": "2.16.5",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@webstudio-is/image": "0.296.0",
    "@webstudio-is/react-sdk": "0.296.0",
    "@webstudio-is/sdk": "0.296.0",
    "@webstudio-is/sdk-components-animation": "0.296.0",
    "@webstudio-is/sdk-components-react": "0.296.0",
    "@webstudio-is/sdk-components-react-radix": "0.296.0",
    "@webstudio-is/sdk-components-react-remix": "0.296.0",
    "@webstudio-is/wsauth": "0.296.0",
    "isbot": "^5.1.25",
    "react": "18.3.0-canary-14898b6a9-20240318",
    "react-dom": "18.3.0-canary-14898b6a9-20240318",
    "shiki": "4.4.1",
    "vite": "^6.3.4",
    "webstudio": "^0.296.0",
    "wrangler": "^4.14.1"
  },
  "private": true,
  "sideEffects": false,
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240620.0",
    "@remix-run/dev": "2.16.5",
    "@types/react": "^18.2.70",
    "@types/react-dom": "^18.2.25",
    "typescript": "7.0.2",
    "vite": "^6.3.4",
    "wrangler": "^3.63.2"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  }
}